{
  "name": "devopsindex",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/sync-content.js && astro dev",
    "build": "node scripts/sync-content.js && astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "sync:watch": "node scripts/sync-content.js --watch"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.3",
    "astro": "6.4.2",
    "pagefind": "^1",
    "rehype-external-links": "3.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.1",
    "tailwindcss": "4.2.3",
    "unified": "11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "vite": "7.3.3"
  }
}
