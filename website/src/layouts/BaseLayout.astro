---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'DevOps reference — Kubernetes, Linux, Docker, AWS, GCP, CI/CD and more' } = Astro.props;

const allTopics = await getCollection('topics');
// Build sidebar: sections ordered 1-16, each with their pages
const sectionMap = new Map<string, { sectionTitle: string; sectionOrder: number; pages: typeof allTopics }>();
for (const t of allTopics) {
  const key = t.data.section;
  if (!sectionMap.has(key)) {
    sectionMap.set(key, { sectionTitle: t.data.sectionTitle, sectionOrder: t.data.sectionOrder, pages: [] });
  }
  sectionMap.get(key)!.pages.push(t);
}
const sections = Array.from(sectionMap.values()).sort((a, b) => a.sectionOrder - b.sectionOrder);
// Sort pages within each section by read order
for (const s of sections) {
  s.pages.sort((a, b) => a.data.pageOrder - b.data.pageOrder);
}

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | DevOpsIndex</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Apply a saved theme choice before first paint, so toggling on one
       page doesn't flash back to the system default when navigating to
       the next (this is a classic multi-page site, not an SPA — every
       navigation reloads the document). Falls back silently if
       localStorage is unavailable (privacy mode, etc). -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('devopsindex-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    })();
  </script>
  <!-- VS Code-style syntax highlighting for code fences (see initSyntaxHighlighting below) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/vs2015.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
</head>
<body class="min-h-screen flex flex-col">
  <header class="site-header px-6 py-3.5 flex items-center gap-5">
    <a href="/" class="wordmark"><span class="prompt">❯</span>devopsindex<span class="cursor"></span></a>
    <span class="site-tagline hidden sm:block">Kubernetes · Linux · Docker · AWS · GCP · CI/CD</span>
    <div class="header-right">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">
        <span class="sw"></span>--theme=<span class="theme-toggle-label">dark</span>
      </button>
      <button id="mobile-menu-btn" class="mobile-menu-btn lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <!-- Sidebar -->
    <nav id="sidebar" class="sidebar hidden lg:flex flex-col w-64 overflow-y-auto py-4 shrink-0">
      {sections.map(section => (
        <details class="group" open={currentPath.startsWith(`/topic/${section.pages[0]?.data.section}`)}>
          <summary class="sidebar-summary">
            <span class="sidebar-index">{section.sectionOrder}</span>
            <a href={`/topic/${section.pages[0]?.data.section}`} onclick="event.stopPropagation()">
              {section.sectionTitle}
            </a>
          </summary>
          {section.pages.filter(page => page.data.pageSlug !== page.data.section).map(page => {
            const href = `/topic/${page.data.pageSlug}`;
            const isActive = currentPath === href || currentPath === href + '/';
            return (
              <a href={href} class={`sidebar-link ${isActive ? 'active' : ''}`}>
                {page.data.title}
              </a>
            );
          })}
        </details>
      ))}
    </nav>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto p-6">
      <slot />
    </main>
  </div>

  <script>
    // Mobile sidebar toggle
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('flex');
        sidebar.classList.toggle('fixed');
        sidebar.classList.toggle('inset-y-0');
        sidebar.classList.toggle('left-0');
        sidebar.classList.toggle('z-50');
        sidebar.classList.toggle('pt-16');
      }
    });

    // ── Theme toggle ──────────────────────────────────────────
    // Bare :root carries light tokens, prefers-color-scheme swaps to
    // dark, and an explicit data-theme attribute (set here) overrides
    // system preference in either direction — see global.css. Persisted
    // to localStorage so it survives full-page navigations (this is a
    // classic multi-page Astro site, not an SPA); the inline <script
    // is:inline> in <head> applies the saved value before first paint
    // to avoid a flash of the wrong theme.
    function currentTheme(): 'light' | 'dark' {
      const attr = document.documentElement.getAttribute('data-theme');
      if (attr === 'light' || attr === 'dark') return attr;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    function updateThemeToggleLabels(theme: string) {
      document.querySelectorAll<HTMLElement>('.theme-toggle-label').forEach(el => { el.textContent = theme; });
    }
    function initThemeToggle() {
      updateThemeToggleLabels(currentTheme());
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('devopsindex-theme', next); } catch (e) { /* privacy mode etc */ }
        updateThemeToggleLabels(next);
      });
    }

    // Mermaid rendering — dynamic import so a CDN failure can't crash the
    // whole module and silence every other interactive component on the page.
    // Theme picked from the current light/dark state at render time; note
    // this only affects the INITIAL render — toggling the theme after
    // diagrams are already drawn as SVG does not currently re-theme them
    // (a live re-render-on-toggle is a possible future enhancement, out
    // of scope for this pass).
    function renderMermaid() {
      const blocks: { pre: Element; src: string; id: string }[] = [];
      document.querySelectorAll('pre > code.language-mermaid').forEach((el, i) => {
        const pre = el.parentElement;
        if (!pre) return;
        const src = el.textContent || '';
        const id = `mermaid-${i}-${Math.floor(performance.now())}`;
        const div = document.createElement('div');
        div.className = 'mermaid my-6';
        div.id = id;
        div.textContent = src;
        pre.replaceWith(div);
        blocks.push({ pre, src, id });
      });
      if (!blocks.length) return;
      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
        .then(m => {
          m.default.initialize({ startOnLoad: false, theme: currentTheme() === 'light' ? 'default' : 'dark', securityLevel: 'loose' });
          m.default.run();
        })
        .catch(err => console.warn('[DevOpsIndex] Mermaid failed to load:', err));
    }

    // Syntax highlighting — hljs is a classic CDN script loaded in <head>.
    // Guard against it not being present (slow network, CDN error, ad blocker)
    // so a missing hljs can never silently kill tabs/steppers/toggles below.
    declare const hljs: any;
    function initSyntaxHighlighting() {
      if (typeof hljs === 'undefined') return;
      document.querySelectorAll<HTMLElement>('pre > code:not(.language-mermaid)').forEach(el => {
        hljs.highlightElement(el);
      });
    }

    // Copy button injection
    function addCopyButtons() {
      document.querySelectorAll('pre').forEach(pre => {
        if (pre.querySelector('.copy-btn')) return; // idempotent
        const code = pre.querySelector('code');
        if (!code) return;
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(code.textContent || '').then(() => {
            btn.textContent = 'Copied!';
            btn.style.color = '#86efac';
            setTimeout(() => {
              btn.textContent = 'Copy';
              btn.style.color = '';
            }, 1500);
          });
        });
        pre.appendChild(btn);
      });
    }

    // ── Interactive content components (quiz, tabs, stepper, toggle) ──
    // See website/COMPONENTS.md for the HTML authoring syntax. These wire
    // up any matching markup that came through raw from markdown files.

    function initQuizzes() {
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.quiz-card'));
      cards.forEach(card => {
        const btn = card.querySelector<HTMLButtonElement>('.quiz-reveal');
        const answer = card.querySelector<HTMLElement>('.quiz-a');
        btn?.addEventListener('click', () => {
          card.classList.add('revealed');
          if (answer) answer.hidden = false;
          updateQuizProgress();
        });
      });

      // Optional progress pill: <div class="quiz-progress" data-quiz-progress></div>
      function updateQuizProgress() {
        document.querySelectorAll<HTMLElement>('[data-quiz-progress]').forEach(el => {
          const total = cards.length;
          const done = cards.filter(c => c.classList.contains('revealed')).length;
          const fill = el.querySelector<HTMLElement>('.quiz-progress-fill');
          const label = el.querySelector<HTMLElement>('.quiz-progress-label');
          if (fill) fill.style.width = total ? `${(done / total) * 100}%` : '0%';
          if (label) label.textContent = `${done}/${total} checks`;
        });
      }
      updateQuizProgress();
    }

    function initTabGroups() {
      document.querySelectorAll<HTMLElement>('.tab-group').forEach(group => {
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.tab-buttons [data-tab]'));
        const panels = Array.from(group.querySelectorAll<HTMLElement>('.tab-panel'));
        buttons.forEach(btn => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.tab;
            buttons.forEach(b => b.classList.toggle('active', b === btn));
            panels.forEach(p => p.classList.toggle('active', p.dataset.tabPanel === target));
          });
        });
      });
    }

    function initSteppers() {
      document.querySelectorAll<HTMLElement>('.stepper').forEach(stepper => {
        // Only select panels that are direct children of this stepper's
        // .stepper-panels — avoids grabbing panels from a nested stepper.
        const panelsContainer = stepper.querySelector<HTMLElement>('.stepper-panels');
        if (!panelsContainer) return;
        const panels = Array.from(panelsContainer.querySelectorAll<HTMLElement>(':scope > .stepper-panel'));
        if (!panels.length) return;

        const prevBtn = stepper.querySelector<HTMLButtonElement>('.stepper-prev');
        const nextBtn = stepper.querySelector<HTMLButtonElement>('.stepper-next');
        const dotsEl  = stepper.querySelector<HTMLElement>('.stepper-dots');
        const labelEl = stepper.querySelector<HTMLElement>('.stepper-label');
        let current = 0;

        if (dotsEl) {
          panels.forEach((_, i) => {
            const dot = document.createElement('span');
            if (i === 0) dot.classList.add('active');
            dot.addEventListener('click', () => goTo(i));
            dotsEl.appendChild(dot);
          });
        }

        function render() {
          panels.forEach((p, i) => p.classList.toggle('active', i === current));
          if (dotsEl) Array.from(dotsEl.children).forEach((d, i) => d.classList.toggle('active', i === current));
          if (prevBtn) prevBtn.disabled = current === 0;
          if (nextBtn) nextBtn.disabled = current === panels.length - 1;
          if (labelEl) labelEl.textContent = `Step ${current + 1} of ${panels.length}`;
        }
        function goTo(i: number) { current = Math.max(0, Math.min(panels.length - 1, i)); render(); }

        prevBtn?.addEventListener('click', () => goTo(current - 1));
        nextBtn?.addEventListener('click', () => goTo(current + 1));
        render();
      });
    }

    function initToggles() {
      document.querySelectorAll<HTMLElement>('.toggle-switch').forEach(group => {
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.toggle-buttons [data-toggle-opt]'));
        const panels = Array.from(group.querySelectorAll<HTMLElement>('.toggle-panel'));
        buttons.forEach(btn => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.toggleOpt;
            buttons.forEach(b => b.classList.toggle('active', b === btn));
            panels.forEach(p => p.classList.toggle('active', p.dataset.togglePanel === target));
          });
        });
      });
    }

    // Run all init functions independently — a failure in one must never
    // silence the rest (e.g. hljs missing must not break tabs/steppers).
    function init() {
      const steps: [string, () => void][] = [
        ['initThemeToggle',        initThemeToggle],
        ['renderMermaid',          renderMermaid],
        ['addCopyButtons',         addCopyButtons],
        ['initQuizzes',            initQuizzes],
        ['initTabGroups',          initTabGroups],
        ['initSteppers',           initSteppers],
        ['initToggles',            initToggles],
        ['initSyntaxHighlighting', initSyntaxHighlighting], // last: cosmetic only
      ];
      for (const [name, fn] of steps) {
        try {
          fn();
        } catch (err) {
          console.warn(`[DevOpsIndex] ${name} failed:`, err);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // If hljs loads after DOMContentLoaded (e.g. slow network), highlight then.
    document.querySelector<HTMLScriptElement>('script[src*="highlight.js"]')
      ?.addEventListener('load', () => {
        try { initSyntaxHighlighting(); } catch (_) {}
      });
  </script>
</body>
</html>
