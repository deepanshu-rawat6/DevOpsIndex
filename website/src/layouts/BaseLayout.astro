---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'DevOps reference — Kubernetes, Linux, Docker, AWS, GCP, CI/CD and more' } = Astro.props;

const allTopics = await getCollection('topics');
// Build sidebar: sections ordered 1-16, each with their pages
const sectionMap = new Map<string, { sectionTitle: string; sectionOrder: number; pages: typeof allTopics }>();
for (const t of allTopics) {
  const key = t.data.section;
  if (!sectionMap.has(key)) {
    sectionMap.set(key, { sectionTitle: t.data.sectionTitle, sectionOrder: t.data.sectionOrder, pages: [] });
  }
  sectionMap.get(key)!.pages.push(t);
}
const sections = Array.from(sectionMap.values()).sort((a, b) => a.sectionOrder - b.sectionOrder);
// Sort pages within each section by read order
for (const s of sections) {
  s.pages.sort((a, b) => a.data.pageOrder - b.data.pageOrder);
}

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | DevOpsIndex</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- VS Code-style syntax highlighting for code fences (see initSyntaxHighlighting below) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/vs2015.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
</head>
<body class="min-h-screen flex flex-col bg-slate-900 text-slate-200">
  <header class="border-b border-slate-800 px-6 py-4 flex items-center gap-4">
    <a href="/" class="text-xl font-bold text-blue-400 hover:text-blue-300">DevOpsIndex</a>
    <span class="text-slate-500 text-sm hidden sm:block">Kubernetes · Linux · Docker · AWS · GCP · CI/CD</span>
    <button id="mobile-menu-btn" class="ml-auto lg:hidden text-slate-400 hover:text-slate-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <!-- Sidebar -->
    <nav id="sidebar" class="hidden lg:flex flex-col w-64 border-r border-slate-800 overflow-y-auto py-4 shrink-0">
      {sections.map(section => (
        <details class="group" open={currentPath.startsWith(`/topic/${section.pages[0]?.data.section}`)}>
          <summary class="flex items-center gap-2 px-4 py-1.5 text-xs font-semibold text-slate-500 uppercase tracking-wider cursor-pointer hover:text-slate-300 select-none list-none">
            <span class="w-5 h-5 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center shrink-0">{section.sectionOrder}</span>
            <a href={`/topic/${section.pages[0]?.data.section}`} class="hover:text-blue-400" onclick="event.stopPropagation()">
              {section.sectionTitle}
            </a>
          </summary>
          {section.pages.filter(page => page.data.pageSlug !== page.data.section).map(page => {
            const href = `/topic/${page.data.pageSlug}`;
            const isActive = currentPath === href || currentPath === href + '/';
            return (
              <a
                href={href}
                class={`block pl-10 pr-4 py-1 text-sm hover:bg-slate-800 hover:text-blue-400 transition-colors ${isActive ? 'bg-slate-800 text-blue-400 border-l-2 border-blue-400' : 'text-slate-400'}`}
              >
                {page.data.title}
              </a>
            );
          })}
        </details>
      ))}
    </nav>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto p-6">
      <slot />
    </main>
  </div>

  <script>
    // Mobile sidebar toggle
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('flex');
        sidebar.classList.toggle('fixed');
        sidebar.classList.toggle('inset-y-0');
        sidebar.classList.toggle('left-0');
        sidebar.classList.toggle('z-50');
        sidebar.classList.toggle('bg-slate-900');
        sidebar.classList.toggle('pt-16');
      }
    });

    // Mermaid rendering
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });

    function renderMermaid() {
      document.querySelectorAll('pre > code.language-mermaid').forEach((el, i) => {
        const pre = el.parentElement;
        if (!pre) return;
        const src = el.textContent || '';
        const div = document.createElement('div');
        div.className = 'mermaid my-6';
        div.id = `mermaid-${Date.now()}-${i}`;
        div.textContent = src;
        pre.replaceWith(div);
      });
      mermaid.run();
    }

    // Syntax highlighting (VS Code-like theme, loaded in <head> as a
    // classic global script — see BaseLayout's <head> for the CDN tags).
    // Runs after renderMermaid() so `.language-mermaid` blocks have already
    // been swapped out for rendered SVG and never reach the highlighter.
    declare const hljs: any;
    function initSyntaxHighlighting() {
      document.querySelectorAll<HTMLElement>('pre > code:not(.language-mermaid)').forEach(el => {
        hljs.highlightElement(el);
      });
    }

    // Copy button injection
    function addCopyButtons() {
      document.querySelectorAll('pre').forEach(pre => {
        const code = pre.querySelector('code');
        if (!code) return;
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(code.textContent || '').then(() => {
            btn.textContent = 'Copied!';
            btn.style.color = '#86efac';
            setTimeout(() => {
              btn.textContent = 'Copy';
              btn.style.color = '';
            }, 1500);
          });
        });
        pre.appendChild(btn);
      });
    }

    // ── Interactive content components (quiz, tabs, stepper, toggle) ──
    // See website/COMPONENTS.md for the HTML authoring syntax. These wire
    // up any matching markup that came through raw from markdown files.

    function initQuizzes() {
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.quiz-card'));
      cards.forEach(card => {
        const btn = card.querySelector<HTMLButtonElement>('.quiz-reveal');
        const answer = card.querySelector<HTMLElement>('.quiz-a');
        btn?.addEventListener('click', () => {
          card.classList.add('revealed');
          if (answer) answer.hidden = false;
          updateQuizProgress();
        });
      });

      // Optional progress pill: <div class="quiz-progress" data-quiz-progress></div>
      function updateQuizProgress() {
        document.querySelectorAll<HTMLElement>('[data-quiz-progress]').forEach(el => {
          const total = cards.length;
          const done = cards.filter(c => c.classList.contains('revealed')).length;
          const fill = el.querySelector<HTMLElement>('.quiz-progress-fill');
          const label = el.querySelector<HTMLElement>('.quiz-progress-label');
          if (fill) fill.style.width = total ? `${(done / total) * 100}%` : '0%';
          if (label) label.textContent = `${done}/${total} checks`;
        });
      }
      updateQuizProgress();
    }

    function initTabGroups() {
      document.querySelectorAll<HTMLElement>('.tab-group').forEach(group => {
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.tab-buttons [data-tab]'));
        const panels = Array.from(group.querySelectorAll<HTMLElement>('.tab-panel'));
        buttons.forEach(btn => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.tab;
            buttons.forEach(b => b.classList.toggle('active', b === btn));
            panels.forEach(p => p.classList.toggle('active', p.dataset.tabPanel === target));
          });
        });
      });
    }

    function initSteppers() {
      document.querySelectorAll<HTMLElement>('.stepper').forEach(stepper => {
        const panels = Array.from(stepper.querySelectorAll<HTMLElement>('.stepper-panel'));
        const prevBtn = stepper.querySelector<HTMLButtonElement>('.stepper-prev');
        const nextBtn = stepper.querySelector<HTMLButtonElement>('.stepper-next');
        const dotsEl = stepper.querySelector<HTMLElement>('.stepper-dots');
        const labelEl = stepper.querySelector<HTMLElement>('.stepper-label');
        let current = 0;

        if (dotsEl) {
          panels.forEach((_, i) => {
            const dot = document.createElement('span');
            if (i === 0) dot.classList.add('active');
            dot.addEventListener('click', () => goTo(i));
            dotsEl.appendChild(dot);
          });
        }

        function render() {
          panels.forEach((p, i) => p.classList.toggle('active', i === current));
          if (dotsEl) Array.from(dotsEl.children).forEach((d, i) => d.classList.toggle('active', i === current));
          if (prevBtn) prevBtn.disabled = current === 0;
          if (nextBtn) nextBtn.disabled = current === panels.length - 1;
          if (labelEl) labelEl.textContent = `Step ${current + 1} of ${panels.length}`;
        }
        function goTo(i: number) { current = Math.max(0, Math.min(panels.length - 1, i)); render(); }

        prevBtn?.addEventListener('click', () => goTo(current - 1));
        nextBtn?.addEventListener('click', () => goTo(current + 1));
        render();
      });
    }

    function initToggles() {
      document.querySelectorAll<HTMLElement>('.toggle-switch').forEach(group => {
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.toggle-buttons [data-toggle-opt]'));
        const panels = Array.from(group.querySelectorAll<HTMLElement>('.toggle-panel'));
        buttons.forEach(btn => {
          btn.addEventListener('click', () => {
            const target = btn.dataset.toggleOpt;
            buttons.forEach(b => b.classList.toggle('active', b === btn));
            panels.forEach(p => p.classList.toggle('active', p.dataset.togglePanel === target));
          });
        });
      });
    }

    function init() {
      renderMermaid();
      initSyntaxHighlighting();
      addCopyButtons();
      initQuizzes();
      initTabGroups();
      initSteppers();
      initToggles();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
