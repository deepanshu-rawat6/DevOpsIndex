---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';
import { renderMd } from '../../lib/renderMd';

export async function getStaticPaths() {
  const allTopics = await getCollection('topics');
  const sections = [...new Set(allTopics.map(t => t.data.section))];
  return sections.map(section => ({ params: { section } }));
}

const { section } = Astro.params;
const allTopics = await getCollection('topics');
const pages = allTopics
  .filter(t => t.data.section === section)
  .sort((a, b) => a.data.pageOrder - b.data.pageOrder);

const sectionTitle = pages[0]?.data.sectionTitle ?? section;
const sectionOrder = pages[0]?.data.sectionOrder ?? 0;

// Separate the root README page from sub-pages
const rootPage = pages.find(t => t.data.pageSlug === section);
const subPages = pages.filter(t => t.data.pageSlug !== section);

// Render README markdown if it exists
let readmeHtml = '';
if (rootPage) {
  const mdPath = path.resolve('src/data/topics', rootPage.data.filePath);
  if (fs.existsSync(mdPath)) {
    const raw = fs.readFileSync(mdPath, 'utf8');
    readmeHtml = await renderMd(raw, section);
  }
}
---

<BaseLayout title={sectionTitle}>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-blue-400">Home</a>
      <span class="mx-2">›</span>
      <span class="text-slate-300">{sectionTitle}</span>
    </nav>

    <div class="flex items-center gap-3 mb-8">
      <h1 class="text-2xl font-bold text-slate-100">{sectionTitle}</h1>
      <span class="text-xs px-2 py-1 rounded bg-slate-800 text-slate-400">#{sectionOrder}</span>
      <span class="text-xs px-2 py-1 rounded bg-slate-800 text-slate-400">{subPages.length} pages</span>
    </div>

    <!-- Inline README content if available -->
    {readmeHtml && (
      <div class="prose max-w-none mb-10">
        <Fragment set:html={readmeHtml} />
      </div>
    )}

    <!-- Sub-pages list -->
    {subPages.length > 0 && (
      <div>
        {readmeHtml && <h2 class="text-lg font-semibold text-slate-300 mb-4 border-b border-slate-800 pb-2">Pages in this section</h2>}
        <div class="space-y-2">
          {subPages.map((page, i) => (
            <a
              href={`/topic/${page.data.pageSlug}`}
              class="flex items-center gap-4 px-4 py-3 rounded-lg border border-slate-800 bg-slate-800/30 hover:bg-slate-800 hover:border-slate-700 transition-colors group"
            >
              <span class="w-7 h-7 rounded bg-slate-800 text-slate-500 text-xs flex items-center justify-center shrink-0 group-hover:text-blue-400">
                {i + 1}
              </span>
              <div class="text-slate-200 text-sm font-medium group-hover:text-blue-400">
                {page.data.title}
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
