---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';
import { renderMd } from '../../lib/renderMd';

export async function getStaticPaths() {
  const allTopics = await getCollection('topics');
  // Exclude single-segment slugs (e.g., "kubernetes") — handled by [section].astro
  return allTopics
    .filter(t => t.data.pageSlug.includes('/'))
    .map(t => {
      const sectionPages = allTopics
        .filter(s => s.data.section === t.data.section)
        .sort((a, b) => a.data.pageOrder - b.data.pageOrder);
      const idx = sectionPages.findIndex(s => s.data.pageSlug === t.data.pageSlug);
      return {
        params: { slug: t.data.pageSlug },
        props: {
          topic: t.data,
          prev: idx > 0 ? sectionPages[idx - 1].data : null,
          next: idx < sectionPages.length - 1 ? sectionPages[idx + 1].data : null,
        },
      };
    });
}

const { topic, prev, next } = Astro.props;

const mdPath = path.resolve('src/data/topics', topic.filePath);
const mdRaw = fs.existsSync(mdPath) ? fs.readFileSync(mdPath, 'utf8') : '';

// subpath = directory within section (e.g. "jenkins" for cicd/jenkins/README.md)
const fileDir = path.dirname(topic.filePath).replace(/\\/g, '/');
const subpath = fileDir.includes('/') ? fileDir.split('/').slice(1).join('/') : '';

const html = await renderMd(mdRaw, topic.section, subpath);

const pageHref = (t: { pageSlug: string; section: string }) =>
  t.pageSlug === t.section ? `/topic/${t.section}` : `/topic/${t.pageSlug}`;
---

<BaseLayout title={topic.title}>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="crumb-trail mb-6">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href={`/topic/${topic.section}`}>{topic.sectionTitle}</a>
      {topic.pageSlug !== topic.section && (
        <>
          <span class="sep">›</span>
          <span class="current">{topic.title}</span>
        </>
      )}
    </nav>

    <!-- Prerequisites -->
    {topic.prerequisites && topic.prerequisites.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mb-6 px-4 py-3 rounded-lg"
           style="border: 1px solid var(--border); background: var(--surface)">
        <span class="text-sm font-semibold mr-1" style="color: var(--text-muted)">Before you start:</span>
        {topic.prerequisites.map((p: { title: string; slug: string }) => (
          <a href={`/topic/${p.slug}`}
             class="text-sm px-3 py-1 rounded-full font-medium"
             style="background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent)">
            {p.title}
          </a>
        ))}
      </div>
    )}

    <!-- Content -->
    <div class="prose max-w-none">
      <Fragment set:html={html} />
    </div>

    <!-- Prev / Next -->
    {(prev || next) && (
      <div class="flex justify-between mt-12 pt-6 gap-4" style="border-top: 1px solid var(--border)">
        {prev ? (
          <a href={pageHref(prev)} class="pager-link flex-1 text-left px-4 py-3">
            <div class="pager-eyebrow mb-1">← Previous</div>
            <div class="pager-title">{prev.pageSlug === prev.section ? 'Overview' : prev.title}</div>
          </a>
        ) : <div class="flex-1" />}
        {next && (
          <a href={pageHref(next)} class="pager-link flex-1 text-right px-4 py-3">
            <div class="pager-eyebrow mb-1">Next →</div>
            <div class="pager-title">{next.pageSlug === next.section ? 'Overview' : next.title}</div>
          </a>
        )}
      </div>
    )}
  </div>
</BaseLayout>
