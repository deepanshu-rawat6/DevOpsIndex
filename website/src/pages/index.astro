---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const allTopics = await getCollection('topics');

// Build section summary: deduplicate by section
const sectionMap = new Map<string, { slug: string; title: string; order: number; count: number }>();
for (const t of allTopics) {
  const key = t.data.section;
  if (!sectionMap.has(key)) {
    sectionMap.set(key, { slug: key, title: t.data.sectionTitle, order: t.data.sectionOrder, count: 0 });
  }
  sectionMap.get(key)!.count++;
}
const sections = Array.from(sectionMap.values()).sort((a, b) => a.order - b.order);

// Color tiers — each tier represents a learning phase. `key` selects the
// .section-tile modifier class (see global.css); the tier hues themselves
// are tokens (--tier-foundation etc.) so they hold up in both themes.
type TierKey = 'foundation' | 'core' | 'advanced' | 'specialist';
const tierInfo = (order: number): { key: TierKey; tier: string; range: string } => {
  if (order <= 4)  return { key: 'foundation', tier: 'Foundation', range: '01–04' };
  if (order <= 8)  return { key: 'core',        tier: 'Core',        range: '05–08' };
  if (order <= 12) return { key: 'advanced',    tier: 'Advanced',    range: '09–12' };
  return               { key: 'specialist',  tier: 'Specialist',  range: `13–${String(sections.length).padStart(2, '0')}` };
};

// Group real section titles per tier (computed, not hand-maintained — a
// stale hardcoded list here is exactly how a prior version of this page
// drifted out of sync when new sections were added).
const tierSectionNames = (key: TierKey) => sections.filter(s => tierInfo(s.order).key === key).map(s => s.title).join(' · ');

// Homepage stat strip — all computed from real content at build time,
// no hand-maintained numbers to go stale.
function countOccurrences(pattern: RegExp): number {
  let total = 0;
  for (const t of allTopics) {
    const mdPath = path.resolve('src/data/topics', t.data.filePath);
    if (!fs.existsSync(mdPath)) continue;
    const matches = fs.readFileSync(mdPath, 'utf8').match(pattern);
    if (matches) total += matches.length;
  }
  return total;
}
const liveSimCount = countOccurrences(/class="structure-viz"/g);
const quizCount = countOccurrences(/class="quiz-card"/g);

// Tier colors and descriptions — computed once in frontmatter, referenced in template
const tierColors: Record<TierKey, string> = {
  foundation: 'var(--tier-foundation)',
  core:       'var(--tier-core)',
  advanced:   'var(--tier-advanced)',
  specialist: 'var(--tier-specialist)',
};
const tierDescriptions: Record<TierKey, string> = {
  foundation: 'How infrastructure actually works — start here regardless of experience',
  core:       'Shipping and running software reliably in the cloud',
  advanced:   'Operating production systems: observability, internals, modern workloads',
  specialist: "Deep dives — pick by what you're building or what's on-call",
};
const tierKeys: TierKey[] = ['foundation', 'core', 'advanced', 'specialist'];
const tierRepresentative: Record<TierKey, number> = { foundation: 1, core: 5, advanced: 9, specialist: 13 };
---

<BaseLayout title="DevOpsIndex">
  <div class="max-w-6xl mx-auto space-y-10">

    <!-- Hero -->
    <div class="space-y-5">
      <div class="hero-eyebrow"><span class="dot"></span>{allTopics.length} pages · {sections.length} sections · always free</div>
      <h1 class="hero-title text-2xl sm:text-3xl"><span class="prompt">❯</span> devopsindex</h1>
      <p class="text-base sm:text-lg font-semibold" style="color: var(--text)">A structured path through the modern DevOps stack.</p>
      <p class="text-sm sm:text-[15px] leading-relaxed max-w-2xl" style="color: var(--text-secondary)">
        From Linux fundamentals to platform engineering — <b style="color: var(--text)">{liveSimCount} hands-on simulators</b>, <b style="color: var(--text)">{quizCount} knowledge checks</b>, prerequisite-linked topics across {sections.length} sections. No account needed.
      </p>

      <div class="stat-strip">
        <div class="stat"><div class="val" data-count={allTopics.length}>0</div><div class="label">Reference pages</div></div>
        <div class="stat"><div class="val" data-count={sections.length}>0</div><div class="label">Sections</div></div>
        <div class="stat"><div class="val" data-count={liveSimCount}>0</div><div class="label">Live simulators</div></div>
        <div class="stat"><div class="val" data-count={quizCount}>0</div><div class="label">Knowledge checks</div></div>
      </div>

      <a href="/graph" style="display:inline-flex;align-items:center;gap:0.4rem;font-family:var(--mono);font-size:0.8rem;color:var(--text-faint);text-decoration:none;border:1px solid var(--border);padding:0.3rem 0.75rem;border-radius:999px;transition:color 0.15s,border-color 0.15s;" onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'" onmouseout="this.style.color='var(--text-faint)';this.style.borderColor='var(--border)'">⬡ explore as graph →</a>
    </div>

    <!-- Color legend -->
    <div class="panel p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--text-dim)">Color Guide — Learning Tiers</h2>
      <div class="tier-strip">
        <div class="tier-chip"><span class="sw" style="background: var(--tier-foundation)"></span><span class="name">Foundation</span><span class="range">{tierInfo(1).range}</span></div>
        <div class="tier-chip"><span class="sw" style="background: var(--tier-core)"></span><span class="name">Core</span><span class="range">{tierInfo(5).range}</span></div>
        <div class="tier-chip"><span class="sw" style="background: var(--tier-advanced)"></span><span class="name">Advanced</span><span class="range">{tierInfo(9).range}</span></div>
        <div class="tier-chip"><span class="sw" style="background: var(--tier-specialist)"></span><span class="name">Specialist</span><span class="range">{tierInfo(13).range}</span></div>
      </div>
      <p class="text-xs mt-4" style="color: var(--text-faint)">
        <b style="color: var(--tier-foundation)">Foundation</b> ({tierSectionNames('foundation')}) regardless of experience level — they establish the mental models everything else builds on. Move to <b style="color: var(--tier-core)">Core</b> ({tierSectionNames('core')}) once comfortable with containers and K8s basics. <b style="color: var(--tier-advanced)">Advanced</b> ({tierSectionNames('advanced')}) and <b style="color: var(--tier-specialist)">Specialist</b> ({tierSectionNames('specialist')}) sections assume you're operating production systems.
      </p>
    </div>

    <!-- Recommended learning path (tier-based) -->
    <details class="panel group" open>
      <summary class="panel-summary flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--text-dim)">Recommended Learning Path</h2>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180" style="color: var(--text-faint)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="px-5 pb-5 space-y-4 pt-2">
        {tierKeys.map(key => {
          const tierSections = sections.filter(s => tierInfo(s.order).key === key);
          const info = tierInfo(tierRepresentative[key]);
          const color = tierColors[key];
          return (
            <div class="tier-path-group">
              <div class="tier-path-header flex items-center gap-2 mb-2">
                <span class="sw" style={'background:' + color + ';width:10px;height:10px;border-radius:50%;display:inline-block;flex-shrink:0'}></span>
                <span class="text-xs font-semibold uppercase tracking-wider" style={'color:' + color}>{info.tier}</span>
                <span class="text-xs ml-1" style="color: var(--text-faint)">{tierDescriptions[key]}</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {tierSections.map((s, i) => (
                  <a href={'/topic/' + s.slug} class="tier-section-chip flex items-center gap-1.5">
                    <span class="text-xs font-mono" style="color: var(--text-faint)">#{String(s.order).padStart(2, '0')}</span>
                    <span class="text-xs font-semibold" style="color: var(--text)">{s.title}</span>
                    {i < tierSections.length - 1 && <span style="color: var(--border); margin-left: 2px;">→</span>}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </details>

    <!-- Search -->
    <div>
      <input
        type="text"
        id="section-search"
        placeholder="Search sections…"
        class="search-input w-full max-w-md px-4 py-2"
        oninput="filterSections(this.value)"
      />
    </div>

    <!-- Section grid -->
    <div>
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--text-faint)">All Sections</h2>
        <span class="font-mono text-xs" style="color: var(--text-faint)">{sections.length} total</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="section-grid">
        {sections.map(s => {
          const { key, tier, range } = tierInfo(s.order);
          return (
            <a href={`/topic/${s.slug}`} class={`section-tile ${key}`} data-title={s.title.toLowerCase()}>
              <div class="row1">
                <span class="sw"></span>
                <span class="idx">#{String(s.order).padStart(2, '0')}</span>
              </div>
              <h2>{s.title}</h2>
              <div class="flex items-center justify-between mt-1">
                <span class="meta">{s.count} page{s.count !== 1 ? 's' : ''}</span>
                <span class="meta" title={range}>{tier}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

  </div>

  <script>
    function filterSections(query: string) {
      const q = query.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('.section-tile').forEach(card => {
        const title = card.dataset.title || '';
        card.style.display = !q || title.includes(q) ? '' : 'none';
      });
    }
    (window as any).filterSections = filterSections;

    // Hero stat strip — count up on load, respecting reduced-motion.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.stat-strip .val').forEach(el => {
      const target = parseInt(el.dataset.count || '0', 10);
      if (reduceMotion || !target) { el.textContent = String(target); return; }
      const start = performance.now();
      const dur = 900;
      function tick(now: number) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  </script>
</BaseLayout>
