---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'fs';
import path from 'path';

const allTopics = await getCollection('topics');

// Build section summary: deduplicate by section
const sectionMap = new Map<string, { slug: string; title: string; order: number; count: number }>();
for (const t of allTopics) {
  const key = t.data.section;
  if (!sectionMap.has(key)) {
    sectionMap.set(key, { slug: key, title: t.data.sectionTitle, order: t.data.sectionOrder, count: 0 });
  }
  sectionMap.get(key)!.count++;
}
const sections = Array.from(sectionMap.values()).sort((a, b) => a.order - b.order);

// Color tiers — each tier represents a learning phase. `key` selects the
// .section-tile modifier class (see global.css); the tier hues themselves
// are tokens (--tier-foundation etc.) so they hold up in both themes.
type TierKey = 'foundation' | 'core' | 'advanced' | 'specialist';
const tierInfo = (order: number): { key: TierKey; tier: string; range: string } => {
  if (order <= 4)  return { key: 'foundation', tier: 'Foundation', range: '01–04' };
  if (order <= 8)  return { key: 'core',        tier: 'Core',        range: '05–08' };
  if (order <= 12) return { key: 'advanced',    tier: 'Advanced',    range: '09–12' };
  return               { key: 'specialist',  tier: 'Specialist',  range: `13–${String(sections.length).padStart(2, '0')}` };
};

// Group real section titles per tier (computed, not hand-maintained — a
// stale hardcoded list here is exactly how a prior version of this page
// drifted out of sync when new sections were added).
const tierSectionNames = (key: TierKey) => sections.filter(s => tierInfo(s.order).key === key).map(s => s.title).join(' · ');

// Homepage stat strip — all computed from real content at build time,
// no hand-maintained numbers to go stale.
function countOccurrences(pattern: RegExp): number {
  let total = 0;
  for (const t of allTopics) {
    const mdPath = path.resolve('src/data/topics', t.data.filePath);
    if (!fs.existsSync(mdPath)) continue;
    const matches = fs.readFileSync(mdPath, 'utf8').match(pattern);
    if (matches) total += matches.length;
  }
  return total;
}
const liveSimCount = countOccurrences(/class="structure-viz"/g);
const quizCount = countOccurrences(/class="quiz-card"/g);

// Recommended learning path — two tracks
const sde1Path = [
  { step: 1,  section: 'linux',         pages: ['commands', 'boot', 'systemd', 'networking', 'signals', 'containers-evolution'] },
  { step: 2,  section: 'networking',    pages: ['osi-model', 'tcp-udp', 'tls-encryption', 'http-versions'] },
  { step: 3,  section: 'docker',        pages: ['networking', 'debugging'] },
  { step: 4,  section: 'kubernetes',    pages: ['kubectl-cheatsheet', 'workloads', 'resource-limits', 'networking', 'storage', 'rbac', 'helm'] },
  { step: 5,  section: 'cicd',          pages: ['github-actions', 'argocd'] },
  { step: 6,  section: 'iac',           pages: ['terraform', 'cloudformation'] },
  { step: 7,  section: 'aws',           pages: ['services-overview', 'storage-databases', 'messaging-serverless-observability'] },
  { step: 8,  section: 'monitoring',    pages: ['prometheus', 'alertmanager', 'grafana', 'loki', 'alerting-philosophy'] },
  { step: 9,  section: 'git',           pages: ['git-workflows', 'git-fixes'] },
  { step: 10, section: 'sre',           pages: ['k8s-debugging', 'k8s-scenarios', 'aws-scenarios'] },
];

const sde2Path = [
  { step: 1,  section: 'linux',         pages: ['io-models', 'scheduler', 'security', 'memory-tuning', 'cgroup-v2', 'proc-internals', 'strace-perf', 'ebpf-bpftrace'] },
  { step: 2,  section: 'networking',    pages: ['linux-networking', 'grpc-graphql', 'load-balancers', 'cdn'] },
  { step: 3,  section: 'docker',        pages: ['buildkit', 'docker-security', 'internals'] },
  { step: 4,  section: 'kubernetes',    pages: ['autoscaling', 'coredns', 'pod-lifecycle', 'kube-proxy-modes', 'cross-node-networking', 'eks-architecture', 'node-shutdown', 'policy-security'] },
  { step: 5,  section: 'aws',           pages: ['databases-deep-dive', 'ecs-fargate', 'request-flow-alb-to-pod'] },
  { step: 6,  section: 'monitoring',    pages: ['opentelemetry', 'performance-debugging', 'slo-sli', 'thanos-mimir'] },
  { step: 7,  section: 'git',           pages: ['git-internals'] },
  { step: 8,  section: 'advanced',      pages: ['service-mesh', 'ebpf-observability', 'chaos-engineering', 'backup-dr'] },
  { step: 9,  section: 'cicd',          pages: ['gitops-secrets', 'argo-rollouts', 'pipeline-design'] },
  { step: 10, section: 'sre',           pages: ['linux-debugging', 'cicd-scenarios', 'iac-scenarios', 'sre-concepts'] },
  { step: 11, section: 'gcp',           pages: ['services-overview', 'gke', 'bigquery'] },
  { step: 12, section: 'databases',     pages: ['postgres-internals', 'mysql-internals', 'kafka-internals', 'redis-internals', 'replication', 'caching'] },
  { step: 13, section: 'on-prem-k8s',   pages: ['postgres', 'kafka', 'redis-cluster'] },
  { step: 14, section: 'system-design', pages: ['scaling', 'cap-pacelc', 'async-patterns', 'api-design', 'distributed-transactions'] },
  { step: 15, section: 'ai-infra',      pages: ['gpu-scheduling', 'kuberay', 'model-serving', 'llmops'] },
  { step: 16, section: 'mlops',         pages: ['experiment-tracking', 'training-pipelines', 'data-drift'] },
];
---

<BaseLayout title="DevOpsIndex">
  <div class="max-w-6xl mx-auto space-y-10">

    <!-- Hero -->
    <div class="space-y-5">
      <div class="hero-eyebrow"><span class="dot"></span>{allTopics.length} pages synced · build passing</div>
      <h1 class="hero-title text-2xl sm:text-3xl"><span class="prompt">❯</span> devopsindex --learn <span class="arg">kubernetes,databases,networking,system-design</span></h1>
      <p class="text-sm sm:text-[15px] leading-relaxed max-w-2xl" style="color: var(--text-secondary)">
        A reference built like the systems it teaches: <b style="color: var(--text)">{liveSimCount} live simulators</b> you can break on purpose, <b style="color: var(--text)">{quizCount} knowledge checks</b>, across {sections.length} sections — Kubernetes, Linux, Docker, AWS, GCP, CI/CD, SRE and more.
      </p>

      <div class="stat-strip">
        <div class="stat"><div class="val" data-count={allTopics.length}>0</div><div class="label">Reference pages</div></div>
        <div class="stat"><div class="val" data-count={sections.length}>0</div><div class="label">Sections</div></div>
        <div class="stat"><div class="val" data-count={liveSimCount}>0</div><div class="label">Live simulators</div></div>
        <div class="stat"><div class="val" data-count={quizCount}>0</div><div class="label">Knowledge checks</div></div>
      </div>

      <a href="/graph" style="display:inline-flex;align-items:center;gap:0.4rem;font-family:var(--mono);font-size:0.8rem;color:var(--text-faint);text-decoration:none;border:1px solid var(--border);padding:0.3rem 0.75rem;border-radius:999px;transition:color 0.15s,border-color 0.15s;" onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'" onmouseout="this.style.color='var(--text-faint)';this.style.borderColor='var(--border)'">⬡ explore as graph →</a>
    </div>

    <!-- Color legend -->
    <div class="panel p-5">
      <h2 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--text-dim)">Color Guide — Learning Tiers</h2>
      <div class="tier-strip">
        <div class="tier-chip"><span class="sw" style="background: var(--tier-foundation)"></span><span class="name">Foundation</span><span class="range">{tierInfo(1).range}</span></div>
        <div class="tier-chip"><span class="sw" style="background: var(--tier-core)"></span><span class="name">Core</span><span class="range">{tierInfo(5).range}</span></div>
        <div class="tier-chip"><span class="sw" style="background: var(--tier-advanced)"></span><span class="name">Advanced</span><span class="range">{tierInfo(9).range}</span></div>
        <div class="tier-chip"><span class="sw" style="background: var(--tier-specialist)"></span><span class="name">Specialist</span><span class="range">{tierInfo(13).range}</span></div>
      </div>
      <p class="text-xs mt-4" style="color: var(--text-faint)">
        <b style="color: var(--tier-foundation)">Foundation</b> ({tierSectionNames('foundation')}) regardless of experience level — they establish the mental models everything else builds on. Move to <b style="color: var(--tier-core)">Core</b> ({tierSectionNames('core')}) once comfortable with containers and K8s basics. <b style="color: var(--tier-advanced)">Advanced</b> ({tierSectionNames('advanced')}) and <b style="color: var(--tier-specialist)">Specialist</b> ({tierSectionNames('specialist')}) sections assume you're operating production systems.
      </p>
    </div>

    <!-- Recommended learning path (collapsible) -->
    <details class="panel group" open>
      <summary class="panel-summary flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--text-dim)">📚 Recommended Learning Path</h2>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180" style="color: var(--text-faint)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="px-5 pb-5 space-y-6">
        <!-- Tab switcher -->
        <div class="flex gap-2 pt-2 items-center">
          <button id="tab-sde1" onclick="switchTab('sde1')" class="path-tab-btn active">SDE-1 Track</button>
          <button id="tab-sde2" onclick="switchTab('sde2')" class="path-tab-btn">SDE-2 Track</button>
          <span class="ml-auto text-xs self-center hidden sm:block" style="color: var(--text-faint)">Read top-to-bottom within each step</span>
        </div>

        <!-- SDE-1 track -->
        <div id="path-sde1" class="space-y-3">
          <p class="text-xs" style="color: var(--text-faint)">Start here if you're new to DevOps / joining as a junior engineer. Focus on understanding how things work before optimising them.</p>
          <div class="space-y-2">
            {sde1Path.map(step => {
              const sec = sections.find(s => s.slug === step.section);
              return (
                <div class="path-step-card flex items-start gap-3 p-3">
                  <span class="step-badge shrink-0 mt-0.5">{step.step}</span>
                  <div class="min-w-0">
                    <a href={`/topic/${step.section}`} class="step-title text-sm font-semibold">
                      {sec?.title ?? step.section}
                    </a>
                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                      {step.pages.map(page => (
                        <a href={`/topic/${step.section}/${page}`} class="path-page-chip">{page}</a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- SDE-2 track -->
        <div id="path-sde2" class="space-y-3 hidden">
          <p class="text-xs" style="color: var(--text-faint)">Continue here after completing the SDE-1 track, or start here if you already have production experience. Focus on internals, failure modes and system design.</p>
          <div class="space-y-2">
            {sde2Path.map(step => {
              const sec = sections.find(s => s.slug === step.section);
              return (
                <div class="path-step-card flex items-start gap-3 p-3">
                  <span class="step-badge shrink-0 mt-0.5">{step.step}</span>
                  <div class="min-w-0">
                    <a href={`/topic/${step.section}`} class="step-title text-sm font-semibold">
                      {sec?.title ?? step.section}
                    </a>
                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                      {step.pages.map(page => (
                        <a href={`/topic/${step.section}/${page}`} class="path-page-chip">{page}</a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </details>

    <!-- Search -->
    <div>
      <input
        type="text"
        id="section-search"
        placeholder="Search sections…"
        class="search-input w-full max-w-md px-4 py-2"
        oninput="filterSections(this.value)"
      />
    </div>

    <!-- Section grid -->
    <div>
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-sm font-semibold uppercase tracking-wider" style="color: var(--text-faint)">All Sections</h2>
        <span class="font-mono text-xs" style="color: var(--text-faint)">{sections.length} total</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="section-grid">
        {sections.map(s => {
          const { key, tier, range } = tierInfo(s.order);
          return (
            <a href={`/topic/${s.slug}`} class={`section-tile ${key}`} data-title={s.title.toLowerCase()}>
              <div class="row1">
                <span class="sw"></span>
                <span class="idx">#{String(s.order).padStart(2, '0')}</span>
              </div>
              <h2>{s.title}</h2>
              <div class="flex items-center justify-between mt-1">
                <span class="meta">{s.count} page{s.count !== 1 ? 's' : ''}</span>
                <span class="meta" title={range}>{tier}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

  </div>

  <script>
    // Mark learning-path chips for pages the user has already visited
    try {
      const visited: string[] = JSON.parse(localStorage.getItem('devopsindex-visited') || '[]');
      document.querySelectorAll<HTMLAnchorElement>('.path-page-chip').forEach(chip => {
        const href = chip.getAttribute('href') || '';
        if (visited.includes(href) || visited.includes(href.replace(/\/$/, ''))) {
          chip.classList.add('visited');
        }
      });
    } catch (_) {}

    function filterSections(query: string) {
      const q = query.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('.section-tile').forEach(card => {
        const title = card.dataset.title || '';
        card.style.display = !q || title.includes(q) ? '' : 'none';
      });
    }
    (window as any).filterSections = filterSections;

    function switchTab(tab: 'sde1' | 'sde2') {
      const sde1 = document.getElementById('path-sde1');
      const sde2 = document.getElementById('path-sde2');
      const btn1 = document.getElementById('tab-sde1');
      const btn2 = document.getElementById('tab-sde2');
      sde1?.classList.toggle('hidden', tab !== 'sde1');
      sde2?.classList.toggle('hidden', tab !== 'sde2');
      btn1?.classList.toggle('active', tab === 'sde1');
      btn2?.classList.toggle('active', tab === 'sde2');
    }
    (window as any).switchTab = switchTab;

    // Hero stat strip — count up on load, respecting reduced-motion.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.stat-strip .val').forEach(el => {
      const target = parseInt(el.dataset.count || '0', 10);
      if (reduceMotion || !target) { el.textContent = String(target); return; }
      const start = performance.now();
      const dur = 900;
      function tick(now: number) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  </script>
</BaseLayout>
